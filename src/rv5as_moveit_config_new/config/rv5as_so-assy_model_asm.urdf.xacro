<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rv5as_so-assy_model_asm">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import rv5as_so-assy_model_asm urdf file -->
    <xacro:include filename="$(find rv5as_so-assy_model_asm_description)/urdf/rv5as_so-assy_model_asm.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="rv5as_so-assy_model_asm.ros2_control.xacro" />


    <xacro:rv5as_so-assy_model_asm_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
